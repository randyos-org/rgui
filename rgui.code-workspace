				"label": "zig build",
				"type": "shell",
				"command": "zig",
				"args": [
					"build",
				],
				"options": {
					"shell": {
						"executable": "C:\\Windows\\System32\\cmd.exe",
						"args": ["/c"],
					}
				},
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "focus": true,
          "revealProblems": "never"
        }
			}
		]
